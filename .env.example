# Copie para .env.local (ignorado pelo git) e preencha.
# NUNCA coloque valores reais neste arquivo. O CI falha se encontrar "sb_secret_" no repositório.
# Em produção, os valores ficam no painel da Vercel.

# URL pública do site (metadataBase, canonical, links nos e-mails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — usado SÓ no servidor (o navegador nunca fala com o Supabase, por isso sem NEXT_PUBLIC_).
# Local: valores exibidos por `npm run db:start` (ou `npx supabase status`).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Resend — notificação interna de novo lead (sem dados pessoais no e-mail).
# Sem estas variáveis, as notificações ficam desativadas (o lead é gravado normalmente).
# Sem domínio verificado no Resend, use "AplicarOn <onboarding@resend.dev>" como remetente:
# ele só entrega para o e-mail dono da conta Resend.
RESEND_API_KEY=
NOTIFICACAO_EMAIL_DE=
NOTIFICACAO_EMAIL_PARA=

# Protege /api/cron/tarefas (chamada pelo cron da Vercel).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Protege /api/webhooks/asaas: o mesmo valor do "Token de autenticação" do webhook no painel do Asaas
# (32 a 255 caracteres, gerado lá com "Gerar Token"). Sem ele, o endpoint recusa tudo (401).
ASAAS_WEBHOOK_TOKEN=

# Sentry (sem DSN, o Sentry fica desligado). DSN não é segredo; o AUTH_TOKEN é.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Só no build da Vercel, para enviar source maps (erros legíveis no Sentry).
SENTRY_AUTH_TOKEN=
# Opcional: endpoint "Security Headers" do projeto Sentry, para receber os relatórios da CSP.
SENTRY_CSP_REPORT_URI=

# Opcional: código da meta tag de verificação do Google Search Console (só o valor do content).
GOOGLE_SITE_VERIFICATION=
